{
  "name": "beanstalkd-ts",
  "version": "0.2.1",
  "description": "Beanstalkd client with full typescript support. Extremely fast, lightweight and dependency-free.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "test": "vitest",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "./dist/src"
  ],
  "keywords": [],
  "author": "Fatih Kaya <1994274@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^24.1.0",
    "get-port": "^7.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
